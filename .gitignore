# Ambiente Virtual
venv/
env/
ENV/

# Python / Compilados
__pycache__/
*.py[cod]
*$py.class
*.so

# Flask / Banco de Dados Local
instance/
*.sqlite
*.sqlite3
*.db

# Armazenamento de Arquivos Locais (Mídias, Uploads)
