# haja alguma estrutura inicial necessária, pode-se manter um .gitkeep dentro dele.
storage/

# Arquivos de IDE (VSCode, Eclipse, PyCharm)
.vscode/
.idea/
.project
.pydevproject
*.swp

# Arquivos do Sistema Operacional
.DS_Store
Thumbs.db
desktop.ini

# Logs e outros arquivos temporários
*.log
tmp/
